default_platform(:ios)

BUNDLE_ID = "sa.almubarky.bronz"
TEAM_ID = "5V6TC85KRL"

platform :ios do
  # بناء موقّع جاهز للرفع (مشترك بين TestFlight و App Store)
  private_lane :signed_build do
    setup_ci

    # ربط ملف صلاحيات الإشعارات بالمشروع
    require 'xcodeproj'
    project = Xcodeproj::Project.open('../Runner.xcodeproj')
    project.targets.select { |t| t.name == 'Runner' }.each do |t|
      t.build_configurations.each do |c|
        c.build_settings['CODE_SIGN_ENTITLEMENTS'] = 'Runner/Runner.entitlements'
      end
    end
    project.save

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY"],
      in_house: false
    )

    # force: يعيد إنشاء ملف التزويد حتى يشمل صلاحية الإشعارات المفعّلة حديثًا
    match(
      type: "appstore",
      api_key: api_key,
      app_identifier: [BUNDLE_ID],
      git_url: "https://github.com/almubarky05588-lab/share-certs",
      storage_mode: "git",
      git_branch: "main",
      team_id: TEAM_ID,
      readonly: false,
      force: true
    )

    profile_name = ENV["sigh_#{BUNDLE_ID}_appstore_profile-name"]

    update_code_signing_settings(
      path: "Runner.xcodeproj",
      use_automatic_signing: false,
      team_id: TEAM_ID,
      targets: ["Runner"],
      code_sign_identity: "Apple Distribution",
      bundle_identifier: BUNDLE_ID,
      profile_name: profile_name
    )

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: { BUNDLE_ID => profile_name }
      }
    )

    api_key
  end

  lane :beta do
    api_key = signed_build
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      changelog: "نسخة اختبارية من برونز"
    )
  end

  # رفع للمتجر + البيانات + الصور + إرسال للمراجعة
  lane :release do
    api_key = signed_build
    deliver(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      ipa: lane_context[SharedValues::IPA_OUTPUT_PATH],
      metadata_path: "./fastlane/metadata",
      screenshots_path: "./fastlane/screenshots",
      overwrite_screenshots: true,
      submit_for_review: true,
      automatic_release: true,
      force: true,
      run_precheck_before_submit: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false
      }
    )
  end
end
